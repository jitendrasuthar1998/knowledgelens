# KnowledgeLens Environment Variables Example
# Copy this file to .env.local and populate with your keys. Never commit .env.local!

# AI Provider Configuration (Phase 1)
# Choose: openai OR gemini
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Alternative Provider: Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Database Configuration (Phase 4)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/knowledgelens

# Application Settings
NEXT_PUBLIC_APP_NAME="KnowledgeLens"
MAX_UPLOAD_SIZE_MB=10
